          "name": "Get Product List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Define the JSON Schema for products response\r\nconst productsSchema = {\r\n  \"type\": \"object\",\r\n  \"required\": [\"products\", \"count\", \"offset\", \"limit\"],\r\n  \"properties\": {\r\n    \"count\": { \"type\": \"number\" },\r\n    \"offset\": { \"type\": \"number\" },\r\n    \"limit\": { \"type\": \"number\" },\r\n    \"products\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"object\",\r\n        \"required\": [\"id\", \"title\", \"variants\"],\r\n        \"properties\": {\r\n          \"id\": { \"type\": \"string\" },\r\n          \"title\": { \"type\": \"string\" },\r\n          \"variants\": {\r\n            \"type\": \"array\",\r\n            \"items\": {\r\n              \"type\": \"object\",\r\n              \"required\": [\"id\", \"title\", \"prices\"],\r\n              \"properties\": {\r\n                \"id\": { \"type\": \"string\" },\r\n                \"title\": { \"type\": \"string\" },\r\n                \"prices\": { \"type\": \"array\" }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n};\r\n\r\n// 2. Run the assertion against the response\r\npm.test(\"Products response matches JSON schema\", function () {\r\n    pm.response.to.have.jsonSchema(productsSchema);\r\n});"
                ]
              }
            }
