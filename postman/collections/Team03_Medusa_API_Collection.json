              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Define the JSON Schema for cart response\r\nconst cartSchema = {\r\n  \"type\": \"object\",\r\n  \"required\": [\"cart\"],\r\n  \"properties\": {\r\n    \"cart\": {\r\n      \"type\": \"object\",\r\n      \"required\": [\"id\", \"region_id\", \"items\", \"shipping_methods\"],\r\n      \"properties\": {\r\n        \"id\": { \"type\": \"string\" },\r\n        \"region_id\": { \"type\": \"string\" },\r\n        \"items\": {\r\n          \"type\": \"array\",\r\n          \"items\": {\r\n            \"type\": \"object\",\r\n            \"required\": [\"id\", \"title\", \"quantity\", \"unit_price\"],\r\n            \"properties\": {\r\n              \"id\": { \"type\": \"string\" },\r\n              \"title\": { \"type\": \"string\" },\r\n              \"quantity\": { \"type\": \"number\" },\r\n              \"unit_price\": { \"type\": \"number\" }\r\n            }\r\n          }\r\n        },\r\n        \"shipping_methods\": {\r\n          \"type\": \"array\"\r\n        }\r\n      }\r\n    }\r\n  }\r\n};\r\n\r\n// 2. Run the assertion against the response\r\npm.test(\"Cart response matches JSON schema\", function () {\r\n    pm.response.to.have.jsonSchema(cartSchema);\r\n});"
                ]
