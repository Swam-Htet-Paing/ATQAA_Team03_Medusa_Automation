                "type": "text/javascript",
                "exec": [
                  "// 1. Verify the response status is 200 OK\r\npm.test(\"Status code is 200 OK for shipping options\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Parse the JSON response\r\nconst jsonData = pm.response.json();\r\n\r\n// 3. Verify the shipping_options array exists and has items\r\npm.test(\"Shipping options array is present and not empty\", function () {\r\n    pm.expect(jsonData).to.have.property(\"shipping_options\");\r\n    pm.expect(jsonData.shipping_options).to.be.an(\"array\");\r\n    pm.expect(jsonData.shipping_options.length).to.be.above(0);\r\n});\r\n\r\n// 4. Extract and set the first option's ID to environment variable 'option_id'\r\nif (jsonData.shipping_options && jsonData.shipping_options.length > 0) {\r\n    const selectedOptionId = jsonData.shipping_options[0].id;\r\n    pm.environment.set(\"option_id\", selectedOptionId);\r\n    console.log(\"Successfully extracted and saved option_id: \" + selectedOptionId);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
