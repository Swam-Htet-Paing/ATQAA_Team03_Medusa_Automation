              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Verify the response status is 200 OK\r\npm.test(\"Status code is 200 OK for payment providers\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Parse the JSON response\r\nconst jsonData = pm.response.json();\r\n\r\n// 3. Verify the payment_providers array exists and has items\r\npm.test(\"payment_providers array is present and not empty\", function () {\r\n    pm.expect(jsonData).to.have.property(\"payment_providers\");\r\n    pm.expect(jsonData.payment_providers).to.be.an(\"array\");\r\n    pm.expect(jsonData.payment_providers.length).to.be.above(0);\r\n});\r\n\r\n// 4. Extract and set the first payment provider's ID to environment variable 'provider_id'\r\nif (jsonData.payment_providers && jsonData.payment_providers.length > 0) {\r\n    const providerId = jsonData.payment_providers[0].id;\r\n    pm.environment.set(\"provider_id\", providerId);\r\n    console.log(\"Successfully extracted and saved provider_id: \" + providerId);\r\n} else {\r\n    console.error(\"payment_providers array is empty or missing.\");\r\n}"
                ]
              }
            }
          ],
